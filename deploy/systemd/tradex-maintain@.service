[Unit]
Description=TradeX %i maintenance
After=network-online.target

[Service]
Type=oneshot
User=tradex
Group=tradex
WorkingDirectory=/opt/tradex/current/Phase2A_Execution
EnvironmentFile=/etc/tradex/worker.env
ExecStart=/opt/tradex/current/venv/bin/python /opt/tradex/current/deploy/maintain.py %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradex
TimeoutStartSec=180
